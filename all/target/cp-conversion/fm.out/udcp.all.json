{
  "id":"com.university:udcp.all:slingosgifeature:1.0-SNAPSHOT",
  "bundles":[
    {
      "id":"com.university:udcp.core:1.0-SNAPSHOT",
      "Bundle-SymbolicName":"udcp.core",
      "Bundle-Version":"1.0.0.SNAPSHOT",
      "start-order":"20",
      "content-package-origins":"com.university:udcp.all:1.0-SNAPSHOT"
    }
  ],
  "configurations":  {
    "com.adobe.cq.wcm.core.components.internal.servlets.TableOfContentsFilter~udcp":    {
      "enabled":"true",
      ":configurator:content-package-origins":"com.university:udcp.all:1.0-SNAPSHOT|com.university:udcp.ui.config:1.0-SNAPSHOT"
    },
    "org.apache.sling.commons.log.LogManager.factory.config~udcp":    {
      "org.apache.sling.commons.log.names":[
        "com.university.udcp"
      ],
      "org.apache.sling.commons.log.level":"INFO",
      "org.apache.sling.commons.log.file":"logs/error.log",
      "org.apache.sling.commons.log.additiv":"false",
      ":configurator:content-package-origins":"com.university:udcp.all:1.0-SNAPSHOT|com.university:udcp.ui.config:1.0-SNAPSHOT"
    },
    "org.apache.sling.serviceusermapping.impl.ServiceUserMapperImpl.amended~udcp":    {
      "user.mapping":[
        "udcp.core:udcp-registration-service=[udcp-registration-service]"
      ],
      ":configurator:content-package-origins":"com.university:udcp.all:1.0-SNAPSHOT|com.university:udcp.ui.config:1.0-SNAPSHOT"
    }
  },
  "repoinit:TEXT|true":[
    "# origin=com.university:udcp.all:1.0-SNAPSHOT|com.university:udcp.ui.config:1.0-SNAPSHOT source=org.apache.sling.jcr.repoinit.RepositoryInitializer~udcp\r",
    "create path (sling:OrderedFolder) /content/dam/udcp\r",
    "create path (nt:unstructured) /content/dam/udcp/jcr:content\r",
    "set properties on /content/dam/udcp/jcr:content",
    "  set cq:conf{String} to /conf/udcp",
    "  set jcr:title{String} to \"University Digital Campus Portal\"",
    "end\r",
    "create service user udcp-registration-service\r",
    "create path (sling:Folder) /var/udcp\r",
    "create path (sling:Folder) /var/udcp/event-registrations\r",
    "set ACL for udcp-registration-service",
    "  allow jcr:read, jcr:addChildNodes, jcr:modifyProperties, jcr:nodeTypeManagement on /var/udcp/event-registrations",
    "end"
  ],
  "content-packages:ARTIFACTS|true":[
    "com.university:udcp.ui.config:zip:cp2fm-converted:1.0-SNAPSHOT",
    "com.university:udcp.ui.apps:zip:cp2fm-converted:1.0-SNAPSHOT",
    "com.university:udcp.all:zip:cp2fm-converted:1.0-SNAPSHOT"
  ],
  "oak-index-definitions:JSON|false":{
    "/oak:index/diff.index":{
      "jcr:primaryType":"nam:nt:unstructured",
      "type":"lucene",
      "includedPaths":"/same",
      "queryPaths":"/same",
      "async":"async",
      "diff.json":{
        "jcr:primaryType":"nam:nt:file",
        "jcr:content":{
          "jcr:primaryType":"nam:nt:resource",
          "jcr:mimeType":"application/json",
          "jcr:data":":blobId:ew0KfQ0K"
        }
      }
    }
  },
  "api-regions:JSON|false":[
    {
      "name":"global",
      "exports":[
        "com.university.udcp.core.filters",
        "com.university.udcp.core.listeners",
        "com.university.udcp.core.models",
        "com.university.udcp.core.schedulers",
        "com.university.udcp.core.servlets"
      ]
    },
    {
      "name":"com.adobe.aem.deprecated"
    }
  ]
}